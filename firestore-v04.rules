rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null &&
        request.auth.uid == 'DkNzUvTPU7YIfzuT1LzDUjd8m6y1';
    }

    function esPropietario(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function altaClienteValida(uid) {
      return esPropietario(uid) &&
        request.resource.data.keys().hasAll([
          'nombre', 'apellidos', 'email', 'estado', 'creadoEn'
        ]) &&
        request.resource.data.keys().hasOnly([
          'nombre', 'apellidos', 'email', 'estado', 'creadoEn'
        ]) &&
        request.resource.data.nombre is string &&
        request.resource.data.nombre.size() >= 2 &&
        request.resource.data.nombre.size() <= 100 &&
        request.resource.data.apellidos is string &&
        request.resource.data.apellidos.size() >= 2 &&
        request.resource.data.apellidos.size() <= 140 &&
        request.resource.data.email is string &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.estado == 'pendiente' &&
        request.resource.data.creadoEn == request.time;
    }

    function clienteAprobado() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/clientes/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/clientes/$(request.auth.uid)).data.estado == 'aprobado';
    }

    match /catalogo/{productoId} {
      allow get, list: if esAdmin() || resource.data.publicado == true;
      allow create, update, delete: if esAdmin();
    }

    match /precios/{productoId} {
      allow get: if esAdmin() || (
        clienteAprobado() &&
        exists(/databases/$(database)/documents/catalogo/$(productoId)) &&
        get(/databases/$(database)/documents/catalogo/$(productoId)).data.publicado == true
      );
      allow list, create, update, delete: if esAdmin();
    }

    match /clientes/{uid} {
      allow get: if esAdmin() || esPropietario(uid);
      allow list: if esAdmin();
      allow create: if esAdmin() || altaClienteValida(uid);
      allow update, delete: if esAdmin();
    }

    // Todo documento no contemplado expresamente es privado.
    match /{document=**} {
      allow read, write: if esAdmin();
    }
  }
}
